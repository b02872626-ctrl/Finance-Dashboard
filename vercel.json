{
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/((?!version\\.json$).*)",
      "destination": "https://kash-140.pages.dev/$1",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/version.json",
      "destination": "/Web/version.json"
    }
  ],
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
