<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FinanceApp" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0E1614</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#0E1614</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Android 12+ system splash: bars centred on slate (AppSplash). -->
        <item name="android:windowSplashScreenBackground">@color/kash_slate</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
