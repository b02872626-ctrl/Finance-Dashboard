<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: keep financial data and the Supabase session out of Google
  Drive backups and device-to-device transfers. Transactions are rebuilt
  from SMS + cloud sync after signing in on a new phone; a restored
  single-use refresh token would only break sync.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
