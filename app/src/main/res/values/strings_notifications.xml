<?xml version="1.0" encoding="utf-8"?>
<!--
  Every notification Kash sends. One template per trigger; amounts arrive
  already formatted ("1,200"). Add values-am/strings_notifications.xml for
  Amharic.
-->
<resources>
    <string name="notif_channel_alerts">Money alerts</string>
    <string name="notif_channel_alerts_desc">Low balance, income and unusual fees</string>
    <string name="notif_channel_digest">Evening digest</string>
    <string name="notif_channel_digest_desc">Transactions to review and the day\'s updates, once a day</string>
    <string name="notif_channel_summaries">Summaries</string>
    <string name="notif_channel_summaries_desc">Weekly and month-end summaries</string>
    <string name="notif_channel_health">Account health</string>
    <string name="notif_channel_health_desc">When Kash can\'t read your bank SMS</string>
    <string name="notif_channel_security">Security</string>
    <string name="notif_channel_security_desc">Wrong PIN attempts</string>

    <string name="notif_low_balance_title">%1$s %2$s is getting low 👀</string>
    <string name="notif_low_balance_text_set">only %1$s Br left, under the %2$s alert u set</string>
    <string name="notif_low_balance_text_today">only %1$s Br left, that wont even last a day</string>
    <plurals name="notif_low_balance_text_days">
        <item quantity="one">only %1$s Br left, thats like %2$d day of ur usual spending</item>
        <item quantity="other">only %1$s Br left, thats like %2$d days of ur usual spending</item>
    </plurals>

    <string name="notif_income_title">ayy %1$s %2$s just came in 🎉</string>
    <string name="notif_income_title_noname">hey, %1$s just came in 🎉</string>
    <string name="notif_income_text">thats %1$s this month so far</string>
    <string name="notif_income_text_from">from %1$s. thats %2$s this month so far</string>

    <string name="notif_fee_spike_title">%1$s took %2$s Br in fees on that one 😬</string>
    <string name="notif_fee_spike_text">thats %1$d%% of %2$s, kinda a lot</string>
    <string name="notif_fee_day_title">u paid %1$s Br in bank fees today</string>
    <plurals name="notif_fee_day_text">
        <item quantity="one">1 transaction. small charges add up fast ngl</item>
        <item quantity="other">%d transactions. small charges add up fast ngl</item>
    </plurals>

    <string name="notif_lockout_title">someone tried to open Kash</string>
    <string name="notif_lockout_text">%1$d wrong PINs, so its locked for a bit. if that wasnt u, change ur PIN</string>

    <string name="notif_review_question">%1$s did u send %2$s to %3$s?</string>
    <string name="notif_review_question_text">was that %1$s?</string>
    <plurals name="notif_review_title">
        <item quantity="one">1 thing from today needs a category</item>
        <item quantity="other">%d things from today need a category</item>
    </plurals>
    <plurals name="notif_review_text">
        <item quantity="one">takes like 30 sec, lets go</item>
        <item quantity="other">takes like 30 sec, lets go</item>
    </plurals>

    <plurals name="notif_capture_title">
        <item quantity="one">cant read ur %2$s messages yet 😅</item>
        <item quantity="other">cant read ur %2$s messages yet 😅</item>
    </plurals>
    <plurals name="notif_capture_text">
        <item quantity="one">saved %1$d of them tho, theyll show up once we can</item>
        <item quantity="other">saved %1$d of them tho, theyll show up once we can</item>
    </plurals>

    <plurals name="notif_digest_summary">
        <item quantity="one">1 update from Kash today</item>
        <item quantity="other">%d updates from Kash today</item>
    </plurals>

    <string name="notif_weekly_title">ur week: %1$s spent</string>
    <string name="notif_weekly_text">mostly %1$s. %2$s</string>
    <string name="notif_weekly_more">%1$d%% more than last week hmm</string>
    <string name="notif_weekly_less">%1$d%% less than last week nice</string>
    <string name="notif_weekly_same">bout the same as last week</string>
    <string name="notif_weekly_first">ur first full week w Kash</string>

    <string name="notif_month_title">%1$s done</string>
    <string name="notif_month_title_saved">%1$s done ✅</string>
    <string name="notif_month_text">u kept %1$s out of %2$s that came in. %3$s took the most, %4$s</string>
    <string name="notif_month_text_overspent">spent %1$s more than came in 🫠 %2$s was the big one, %3$s</string>
    <string name="notif_month_text_no_income">spent %1$s. %2$s took the most, %3$s</string>

    <plurals name="notif_backlog_title">
        <item quantity="one">1 transaction still waiting on u</item>
        <item quantity="other">%d transactions still waiting on u</item>
    </plurals>
    <string name="notif_backlog_text">give me a minute n ur reports get way better</string>

    <string name="notif_reengage_title">%1$s where u been 👋</string>
    <string name="notif_reengage_title_noname">hey, where u been 👋</string>
    <plurals name="notif_reengage_text_count">
        <item quantity="one">1 new transaction since u last checked</item>
        <item quantity="other">%d new transactions since u last checked</item>
    </plurals>
    <string name="notif_reengage_text">%1$s spent since u last checked. biggest was %2$s to %3$s</string>
    <string name="notif_reengage_text_plain">%1$s spent since u last checked</string>

    <string name="notif_sms_lost_title">hey, i cant see ur bank texts anymore</string>
    <string name="notif_sms_lost_text">SMS access got turned off. tap to fix it</string>

    <string name="notif_uncategorized">Uncategorized</string>

    <string name="notif_channel_updates">App updates</string>
    <string name="notif_channel_updates_desc">When a new version of Kash is ready to download</string>
    <string name="notif_update_title">Kash %1$s is available</string>
    <string name="notif_update_text">Tap to download the update. Your data stays on your phone.</string>
</resources>
